{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "types",
    "rootDir": "src",
    "module": "commonjs",
    "target": "es2022",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
